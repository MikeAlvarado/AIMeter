    "At this rate it runs out about %@ before it resets." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei diesem Tempo ist es etwa %@ vor dem Reset aufgebraucht."
