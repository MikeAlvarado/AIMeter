    },
    "Your %@ limit reset ahead of schedule — full capacity available." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein %@-Limit wurde früher als geplant zurückgesetzt – volle Kapazität verfügbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
