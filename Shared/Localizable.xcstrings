          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre limite %@ s'est réinitialisée plus tôt que prévu — capacité totale disponible."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
