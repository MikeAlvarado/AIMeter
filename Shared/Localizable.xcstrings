    "AIMeter lives in the notch now — rest the cursor here to peek, click to open." : {
      "comment" : "One-time caption shown inside the notch island's peek on the first launch, so an upgrading user learns it exists.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AIMeter vive ahora en el notch: deja el cursor aquí para asomarlo, haz clic para abrirlo."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AIMeter lebt jetzt im Notch – lass den Cursor hier ruhen für die Vorschau, klicke zum Öffnen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AIMeter vit désormais dans l’encoche : laissez le curseur ici pour un aperçu, cliquez pour ouvrir."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AIMeterはノッチに移りました。カーソルを置くとプレビュー、クリックで開きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AIMeter가 이제 노치에 있습니다. 커서를 올려 두면 미리 보기, 클릭하면 열립니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O AIMeter agora vive no notch: deixe o cursor aqui para espiar, clique para abrir."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AIMeter 现在住在刘海里：把光标停在这里可预览，点击可打开。"
