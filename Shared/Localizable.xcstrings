      }
    },
    "Window" : {
      "localizations" : {

    }
    },
    "With both hidden, AIMeter has no visible controls. Open it again from Finder or Spotlight to bring this window back." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sind beide ausgeblendet, hat AIMeter keine sichtbaren Bedienelemente. Öffne es erneut über den Finder oder Spotlight, um dieses Fenster zurückzuholen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con ambos ocultos, AIMeter no tiene controles visibles. Ábrelo de nuevo desde el Finder o Spotlight para recuperar esta ventana."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les deux masqués, AIMeter n'a plus de commandes visibles. Rouvrez-le depuis le Finder ou Spotlight pour retrouver cette fenêtre."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "両方を隠すとAIMeterの操作部分は見えなくなります。FinderまたはSpotlightからもう一度開くとこのウインドウが戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "둘 다 숨기면 AIMeter에 보이는 조작 요소가 없습니다. Finder나 Spotlight에서 다시 열면 이 윈도우가 돌아옵니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com os dois ocultos, o AIMeter não tem controles visíveis. Abra-o de novo pelo Finder ou Spotlight para trazer esta janela de volta."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "两者都隐藏后，AIMeter 没有可见的控件。从访达或聚焦再次打开即可恢复此窗口。"
          }
        }
      }
    },
    "With the Dock icon hidden, turn this on so AIMeter is back after a restart — otherwise you'll need to open it yourself." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bei ausgeblendetem Dock-Symbol aktiviere dies, damit AIMeter nach einem Neustart wieder da ist – sonst musst du es selbst öffnen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Con el icono del Dock oculto, actívalo para que AIMeter vuelva tras reiniciar; si no, tendrás que abrirlo tú."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avec l'icône du Dock masquée, activez ceci pour qu'AIMeter revienne après un redémarrage — sinon vous devrez l'ouvrir vous-même."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dockアイコンを隠している場合、これをオンにすると再起動後もAIMeterが戻ってきます。オフだと自分で開く必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dock 아이콘을 숨긴 상태라면 이것을 켜야 재시동 후 AIMeter가 다시 실행됩니다. 아니면 직접 열어야 합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Com o ícone do Dock oculto, ative isto para que o AIMeter volte depois de reiniciar — senão você terá que abri-lo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隐藏程序坞图标后，开启此项可让 AIMeter 在重启后自动回来，否则需要你手动打开。"
          }
        }
      }
    },
    "Yes" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ja"
          }
        },
        "es" : {
