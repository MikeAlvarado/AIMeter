          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "잠금 화면 원형 위젯에 표시할 사용 기간입니다. 선택지는 이 계정이 실제로 보고하는 항목과 일치합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
