    },
    "This screen has no notch, so AIMeter draws one at the top edge instead." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta pantalla no tiene notch, así que AIMeter dibuja uno en el borde superior."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Bildschirm hat keinen Notch, daher zeichnet AIMeter stattdessen einen am oberen Rand."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet écran n’a pas d’encoche : AIMeter en dessine une en haut de l’écran à la place."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この画面にはノッチがないため、代わりに画面上端にノッチを描画します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 화면에는 노치가 없어 대신 화면 상단 가장자리에 노치를 그려 표시합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta tela não tem notch, então o AIMeter desenha um na borda superior."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此屏幕没有刘海，AIMeter 会改为在屏幕顶部边缘绘制一个。"
          }
        }
      }
    },
    "Peek on hover" : {
      "comment" : "Notch island setting: resting the cursor on the island shows the primary account's full line.",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asomar al pasar el cursor"
          }
        },
