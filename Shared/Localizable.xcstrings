    "Explore every screen with sample data. Your real accounts come back untouched when you exit." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erkunde jeden Bildschirm mit Beispieldaten. Deine echten Accounts sind beim Beenden unverändert wieder da."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Explora todas las pantallas con datos de ejemplo. Tus cuentas reales vuelven intactas al salir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Explorez chaque écran avec des données d'exemple. Vos vrais comptes reviennent intacts quand vous quittez."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サンプルデータですべての画面を試せます。終了すると実際のアカウントがそのまま戻ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "샘플 데이터로 모든 화면을 둘러보세요. 종료하면 실제 계정이 그대로 돌아옵니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Explore todas as telas com dados de exemplo. Suas contas reais voltam intactas ao sair."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用示例数据浏览每个界面。退出后你的真实账户原样恢复。"
