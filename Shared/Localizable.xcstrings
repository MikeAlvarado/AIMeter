    },
    "You're viewing sample data. Exit to connect your real Claude account." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du siehst Beispieldaten. Beende die Demo, um deinen echten Claude-Account zu verbinden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estás viendo datos de muestra. Sal para conectar tu cuenta real de Claude."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous consultez des données d'exemple. Quittez pour connecter votre vrai compte Claude."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サンプルデータを表示中です。終了すると実際のClaudeアカウントを接続できます。"
